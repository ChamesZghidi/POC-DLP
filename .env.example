# Microsoft 365 / Azure AD — Configuration pour intégration Graph API
# Copiez ce fichier en .env et renseignez vos valeurs

# Identifiants de l'application Entra ID (Azure AD)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
GRAPH_TARGET_USER=pilot.user@contoso.com
DLP_ALERT_RECIPIENTS=rssi@contoso.com,dpo@contoso.com

# Permissions requises (Application permissions) :
#   - Mail.Read
#   - Mail.Send
#   - Files.Read.All (préférer Sites.Selected lorsque le périmètre le permet)
#   - User.Read.All
# Définissez microsoft365.enabled: true uniquement pour un tenant pilote,
# après validation RSSI/DPO. La simulation Purview peut rester active.
# Consentement administrateur obligatoire dans le portail Entra ID
